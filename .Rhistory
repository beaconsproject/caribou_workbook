#| echo: FALSE
#| message: FALSE
#| warning: FALSE
library(glmmTMB)
library(sf)
library(amt)
library(terra)
library(tmap)
library(tidyverse)
getwd()
setwd("little_rancheria")
#| echo: FALSE
#| message: FALSE
#| warning: FALSE
gps <- read_csv("../../data/little_rancheria/caribou.csv") |>
filter(migration=="Fall migration")
trk <- gps |> make_track(.x=longitude, .y=latitude, .t=timestamp, id=id, year=year, crs=4326) |>
transform_coords("EPSG:3578")
xbnd <- hr_kde(trk, levels=0.999) |>
hr_isopleths()
x <- st_read("../../data/little_rancheria/caribou.gpkg", "gps", quiet=TRUE) |>
filter(migration=="Fall migration") |>
select(id) |>
st_transform(3578)
#y <- x |> sample_n(500)
tm_shape(xbnd) + tm_borders() + tm_shape(x) + tm_dots()
#| echo: FALSE
#| message: FALSE
#| warning: FALSE
gps <- read_csv("../../data/little_rancheria/caribou.csv") |>
filter(migration=="Fall migration")
trk <- gps |> make_track(.x=longitude, .y=latitude, .t=timestamp, id=id, year=year, crs=4326) |>
transform_coords("EPSG:3578")
xbnd <- hr_kde(trk, levels=0.999) |>
hr_isopleths()
x <- st_read("../../data/little_rancheria/caribou.gpkg", "gps", quiet=TRUE) |>
filter(migration=="Fall migration") |>
select(id) |>
st_transform(3578)
#y <- x |> sample_n(500)
tm_basemap("Esri.TopoMap") +
tm_shape(xbnd) + tm_borders() +
tm_shape(x) + tm_dots()
#| echo: FALSE
#| message: FALSE
#| warning: FALSE
# Forest proportion
lcc <- rast("../../data/little_rancheria/nalc2020.tif") |>
crop(xbnd, mask=TRUE)
forest <- ifel(lcc<4, 1, 0)
for500 <- focal(forest, w=29, fun="sum")
# Distance to footprint
fp <- st_read("../../data/little_rancheria/disturbances.gpkg", "footprint_500m", quiet=TRUE)
fp.dist <- rasterize(fp, lcc) |>
distance() |>
crop(xbnd, mask=TRUE)
# Distance to burn
burn <- rast("../../data/little_rancheria/burns.tif") |>
resample(lcc)
burn.dist <- burn |> distance() |>
crop(xbnd, mask=TRUE)
r <- c(for500, fp.dist, burn.dist) |>
#r <- c(forest, fp.dist, burn.dist) |>
scale()
names(r) <- c("for500", "fp.dist", "burn.dist")
plot(r)
#| echo: FALSE
#| message: FALSE
#| warning: FALSE
# Used locations
x1 <- terra::extract(r, x, bind=TRUE, ID=FALSE) |>
as_tibble() |>
mutate(status=1)
# Available locations
ids <- unique(x$id)
wts <- as.numeric(table(x$id))
x0 <- spatSample(r, nrow(x)*10, na.rm=TRUE) |>
mutate(id=sample(ids, nrow(x)*10, replace=TRUE, prob=wts),
status=0) |>
as_tibble()
x10 <- rbind(x1, x0)
x10
#| echo: FALSE
#| message: FALSE
#| warning: FALSE
i18 <- x10 |>
filter(id=="SKRATALR0018")
m1 = glmmTMB(status ~ for500 + fp.dist + burn.dist, family=binomial(), data=i18)
summary(m1)
#| echo: FALSE
#| message: FALSE
#| warning: FALSE
# Get estimates without the intercept
coef = fixef(m1)[[1]][-1]
RS = exp(-2*coef[1] + 2*coef[2] + 2*coef[3]) /
exp(2*coef[1] + 2*coef[2] + -2*coef[3])
RS
#| echo: FALSE
#| message: FALSE
#| warning: FALSE
# Coefficient for dist.dev
exp(coef[2])
plot(lcc)
freq(lcc)
#| echo: FALSE
#| message: FALSE
#| warning: FALSE
# Force the intercept to be zero without any error
m1$fit$par[1] = 0
m1$sdr$par.fixed[1] = 0
m1$sdr$cov.fixed[1,] = 0
m1$sdr$cov.fixed[,1] = 0
# Create the dataframe for the combinations of variables for prediction
newdata=data.frame(for500 = 0,
fp.dist = seq(-2,2, by=0.1),
burn.dist = seq(-2,2, by=0.1)
)
# Next, predict
preds = predict(m1,
type = "link", # NOTE: this is where we tell the 'predict' function to use the same link function as the habitat selection function we fit above
newdata = newdata,
se.fit = TRUE
)
# Use the Normal Approximation to get confidence intervals (other approachces are possible too!)
preds$LCL = preds$fit-1.96*preds$se.fit
preds$UCL = preds$fit+1.96*preds$se.fit
preds = data.frame(preds)
# Exponentiate predicted values
preds.exp = exp(preds[,-2])
#| echo: FALSE
#| message: FALSE
#| warning: FALSE
# Force the intercept to be zero without any error
m1$fit$par[1] = 0
m1$sdr$par.fixed[1] = 0
m1$sdr$cov.fixed[1,] = 0
m1$sdr$cov.fixed[,1] = 0
# Create the dataframe for the combinations of variables for prediction
newdata=data.frame(for500 = 0,
fp.dist = seq(-2,2, by=0.1),
burn.dist = seq(-2,2, by=0.1)
)
# Next, predict
preds = predict(m1,
type = "link", # use the same link function as the hsf we fit above
newdata = newdata,
se.fit = TRUE)
# Use the Normal Approximation to get confidence intervals (other approachces are possible too!)
preds$LCL = preds$fit-1.96*preds$se.fit
preds$UCL = preds$fit+1.96*preds$se.fit
preds = data.frame(preds)
# Exponentiate predicted values
preds.exp = exp(preds[,-2])
#| echo: FALSE
#| message: FALSE
#| warning: FALSE
# Plot
plot(newdata$dist.dev,preds.exp$fit,type="l",lwd=3,xlab="Distance to Development (Scaled)",
ylab="Relative Intensity of Selection")
dim(newdata)
#| echo: FALSE
#| message: FALSE
#| warning: FALSE
# Plot
plot(newdata$fp.dist,preds.exp$fit,type="l",lwd=3,xlab="Distance to Development (Scaled)",
ylab="Relative Intensity of Selection")
lines(newdata$fp.dist,preds.exp$LCL,lwd=3,col=2,lty=4)
lines(newdata$fp.dist,preds.exp$UCL,lwd=3,col=2,lty=4)
abline(h=1, lwd=4, col=4)
text(1.5,1.4, "Selection")
text(1.5,0.6, "Avoidance")
glimpse(i18)
quantile(i18)
quantile(i18$fp.dist)
quantile(i18$burn.dist)
quantile(i18$for500)
