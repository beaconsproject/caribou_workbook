```{r}
#| echo: false
#| warning: false
#| message: false
library(sf)
library(amt)
library(tmap)
library(tidyverse)
```

#### 1. Read locations

```{r}
#| echo: false
#| warning: false
#| message: false
gps <- read_csv('../data/little_rancheria/caribou.csv')
gps_sf <- gps |>
  st_as_sf(coords=c("longitude", "latitude"), crs=4326, remove=FALSE) |>
  mutate(year=as.factor(year))
```

#### 2. Make tracks

Tracks are the basic building blocks of movement analysis in the `amt` package. So, we first use the `make_track` function for convert our data.frame into tracks. Note that we have to specify the crs of the data which, in this case, is lat-long or "EPSG:4326". We can then project our coordinates to the Yukon Albers projection using the `transform_coords` function.

```{r}
#| echo: false
#| warning: false
#| message: false
trk <- make_track(gps, longitude, latitude, timestamp, id=id, year=year, season=season, crs=4326)
```

### Overlap

We can compare the overlap in estimated ranges between the two methods:

```{r}
#| warning: false
#| message: false
hr_isopleths(mcp1)
hr_overlap(mcp1, kde1)
hr_overlap(kde1, mcp1)
```



### Estimate all individuals for one season

```{r}
#| warning: false
#| message: false
trk38 <- trk |>
  nest(data = c(x_, y_, t_))
trk38
trk38$data[[1]]
```

```{r}
#| warning: false
#| message: false
hr1 <- trk38 |>
  mutate(
    hr_mcp = map(data, hr_mcp), 
    hr_kde = map(data, hr_kde), 
    #hr_locoh = map(data, ~ hr_locoh(., n = ceiling(sqrt(nrow(.))))), 
    #hr_akde_iid = map(data, ~ hr_akde(., fit_ctmm(., "iid"))),
    #hr_akde_ou = map(data, ~ hr_akde(., fit_ctmm(., "ou")))
  )
str(hr1, 2)
```


```{r}
#| warning: false
#| message: false
hr2 <- hr1 |> dplyr::select(-data) |> 
  pivot_longer(hr_mcp:hr_kde, names_to = "estimator", values_to = "hr") |>
    filter(!season=="other")
str(hr2, 2)
```

```{r}
#| echo: false
#| warning: false
#| message: false
hr2.area <- hr2 |>
  mutate(hr_area = map(hr, hr_area)) |>
  unnest(cols = hr_area) 
head(hr2.area, 2)
```

```{r}
#| echo: false
#| warning: false
#| message: false
library(patchwork)

hr2.area1 <- hr2.area %>% 
  mutate(area = area / 10000) 
hr2.area1$est_lab <- factor(hr2.area1$estimator, 
                            levels = c("hr_mcp", "hr_kde"), 
                            labels = c("MCP", "KDE"))
ci <- hr2.area1 %>% group_by(est_lab, season) %>% 
  summarise(m = mean(area), se = sd(area) / sqrt(n()), 
            me = qt(0.975, n() - 1) * se, lci = m - me, uci = m + me)

p1 <- hr2.area1 %>% ggplot(aes(est_lab, area, col = season)) + 
  geom_jitter(alpha = 0.5, position = position_dodge2(width = 0.5)) +
  geom_pointrange(aes(x = est_lab, y = m, ymin = lci, ymax = uci, col = season), data = ci, inherit.aes = FALSE, 
                  position = position_dodge2(width = 0.5)) +
  theme_light() + 
  theme(axis.title.x = element_blank()) +
  labs(y = expression(paste("HRS [", ha, "]")))
p1
```
